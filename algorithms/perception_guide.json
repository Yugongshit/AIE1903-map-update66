    "argoverse": {
      "scene_id": "0cfNzxkFwK3x3JB9HpcKIqoRCztSAreo__Winter_2021",
      "source_note": {
        "en": "M2 runs the YOLOP ONNX model on camera images. Its outputs are coarse vehicle boxes and binary road/lane masks. Curve colors are assigned by HSV rules; prior-map marking types are separate map inputs.",
        "zh": "M2 对相机图片运行 YOLOP ONNX 模型，输出粗粒度车辆框与道路/车道线二值掩码。曲线颜色由 HSV 规则赋值；先验地图的标线类型属于另一份地图输入。"
      },
      "object_classes": [
        {
          "code": "vehicle",
          "label": {
            "en": "Vehicle (coarse class)",
            "zh": "车辆（粗粒度类别）"
          },
          "frame_annotations": 4976,
          "count_kind": "per_view_2d_detections",
          "unit": {
            "en": "per-view 2D detection boxes; not unique objects or ground-truth annotations",
            "zh": "逐视图二维检测框；不是独立物体数或真值标注数"
          }
        }
      ],
      "candidate_classes": [
        {
          "code": "lane_boundary_candidate",
          "label": {
            "en": "Lane boundary curve observation",
            "zh": "车道边界曲线观测"
          },
          "count": 10278,
          "unit": {
            "en": "per-view curve observations; not confirmed changes",
            "zh": "逐视图曲线观测；不是已确认变化数"
          }
        }
      ],
      "notes": [
        {
          "en": "All 4,976 detector rows use the class vehicle. The current delivery does not distinguish car, truck, bus, barrier, traffic cone or construction worker with this detector.",
          "zh": "全部 4,976 条检测记录均使用 vehicle 类别。当前交付的该检测器不细分汽车、卡车、公交车，也不提供路障、锥桶或施工人员类别。"
        },
        {
          "en": "The 10,278 curves are per-view observations, not 10,278 distinct physical lines or map changes. M2 observation IDs are not temporal track identities.",
          "zh": "10,278 条曲线是逐视图观测，不是 10,278 条独立物理线或地图变化。M2 观测 ID 不是跨帧轨迹身份。"
        },
        {
          "en": "White/yellow colors use non-learned HSV thresholds after YOLOP inference. All curve marking_pattern values are unknown; no solid/dashed or crosswalk classifier is delivered here.",
          "zh": "白色/黄色由 YOLOP 推理后的非学习型 HSV 阈值判定。所有曲线的 marking_pattern 均为 unknown；这里未交付虚实线或人行横道分类器。"
        },
        {
          "en": "Curves retain pixel coordinates and, when ground projection succeeds, City coordinates. Of 10,278 observations, 6,770 have projected geometry and 3,508 fail projection.",
          "zh": "曲线保留像素坐标；地面投影成功时另有 City 坐标。10,278 条观测中，6,770 条具有投影几何，3,508 条投影失败。"
        },
        {
          "en": "Prior-map types such as DOUBLE_SOLID_YELLOW or NONE are map attributes, not YOLOP predictions. NONE does not mean the camera verified an absent line.",
          "zh": "DOUBLE_SOLID_YELLOW、NONE 等先验地图类型属于地图属性，不是 YOLOP 预测。NONE 不代表相机已经确认没有线。"
        },
        {
          "en": "Only three front cameras are processed. Visibility is unknown and no independent accuracy evaluation is provided; a missing detection cannot establish a structural deletion.",
          "zh": "当前只处理三个前向相机。可见性未知，且没有独立准确率评估；漏检不能证明应删除地图结构。"
        },
        {
          "en": "These outputs provide geometric evidence for downstream reliability and structure/state routing; they do not directly decide road-state updates or structural map edits.",
          "zh": "这些输出为后续可靠性判断与结构/状态分流提供几何证据，并不直接决定道路状态更新或地图结构修改。"
        }
      ],
